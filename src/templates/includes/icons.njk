{% macro icon(name, modifier = "") %}
  <svg class="icon{% if modifier %} {{ modifier }}{% endif %}" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {% if name == "arrow-up-right" %}
      <path d="M7 17 17 7M7 7h10v10" />
    {% elif name == "arrow-down-right" %}
      <path d="m7 7 10 10M7 17h10V7" />
    {% elif name == "arrow-down" %}
      <path d="M12 4v16m-6-6 6 6 6-6" />
    {% elif name == "arrow-up" %}
      <path d="M12 20V4m-6 6 6-6 6 6" />
    {% elif name == "arrow-left" %}
      <path d="M20 12H4m6-6-6 6 6 6" />
    {% elif name == "arrow-right" %}
      <path d="M4 12h16m-6-6 6 6-6 6" />
    {% elif name == "replay" %}
      <path d="M4 10a8 8 0 1 1 0 5M4 4v6h6" />
    {% elif name == "swap" %}
      <path d="M3 8h18m-4-4 4 4-4 4M21 16H3m4-4-4 4 4 4" />
    {% elif name == "plus" %}
      <path d="M5 12h14" />
      <path class="icon__vertical" d="M12 5v14" />
    {% elif name == "theme" %}
      <circle cx="12" cy="12" r="9" />
      <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none" />
    {% elif name == "circle" %}
      <circle cx="12" cy="12" r="8" />
    {% elif name == "asterisk" %}
      <path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5" />
    {% elif name == "sparkle" %}
      <path d="m12 2 3 7 7 3-7 3-3 7-3-7-7-3 7-3Z" fill="currentColor" stroke="none" />
    {% elif name == "command" %}
      <path d="M9 9V5.5A2.5 2.5 0 1 0 6.5 8H18a2.5 2.5 0 1 0-2.5-2.5V18a2.5 2.5 0 1 0 2.5-2.5H6a2.5 2.5 0 1 0 2.5 2.5V8" />
    {% elif name == "infinity" %}
      <path d="M12 12c-3-5-9-5-9 0s6 5 9 0 9-5 9 0-6 5-9 0Z" />
    {% elif name == "dot" %}
      <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none" />
    {% elif name == "dash" %}
      <path d="M4 12h16" />
    {% elif name == "slash" %}
      <path d="m15 4-6 16" />
    {% endif %}
  </svg>
{% endmacro %}
